{
  "name": "http-ledger",
  "version": "0.0.3",
  "description": "An Express middleware for comprehensive API request and response logging with beautified console output.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "test": "jest --config jest.config.js --coverage",
    "test:watch": "jest --config jest.config.js --watch",
    "build:cjs": "tsc --project tsconfig.json",
    "build:esm": "tsc --project tsconfig.esm.json",
    "format": "prettier --write ./src",
    "lint": "eslint src --ext .ts",
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "prepublishOnly": "npm run build && npm test",
    "bundlesize": "npm run build && node scripts/bundlesize.js"
  },
  "keywords": [
    "express",
    "middleware",
    "logging",
    "api",
    "logger",
    "request",
    "response",
    "http",
    "typescript"
  ],
  "author": "Shrinath Nayak <shrinathnayak07@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kickstart-sh/http-ledger.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "express": "^4.18.2",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
